#!/usr/bin/env bash
# {{ marker }}
# Server {{ name }}: profile {{ profile }} ({{ engine }})
{% if role %}
# The {{ role | comment }}
{% endif %}
{% if description %}
#   {{ description | comment }}
{% endif %}
{% for line in overrides %}
#   plan override: {{ line | comment }}
{% endfor %}
#
# Runs in the foreground; scripts/run_all.sh starts it in the background with its log in logs/.
#   bash {{ self_path }}
set -euo pipefail

PORT={{ port }}
say() { echo "[server {{ name }}] $*"; }

# Fail now rather than after loading weights: something already listens on the port.
if (exec 3<>/dev/tcp/127.0.0.1/$PORT) 2>/dev/null; then
    say "FATAL: port $PORT is already in use"
    exit 1
fi

{% if nvidia %}
# NVIDIA: CUDA numbers the GPUs in PCI order, as nvidia-smi, oaka and the plan do.
export CUDA_DEVICE_ORDER=PCI_BUS_ID
{% endif %}
export {{ visible }}={{ gpus }}
{% if targets %}

# Profile {{ profile }} is for {{ targets_text }} (GPU arch[:ROCm version]).  oaka checked this
# container at compile time; this script may be rerun by hand elsewhere, so check again.
python3 - "${{ visible }}" <<'PY' || exit 1
import glob, os, subprocess, sys
TARGETS = [{{ targets }}]
WANT = {{ targets_text | tojson_str }}

def rocm():
    if os.environ.get("OAKA_ROCM", "").strip():
        return os.environ["OAKA_ROCM"].strip()
    for root in (os.environ.get("ROCM_PATH"), os.environ.get("ROCM_HOME"), "/opt/rocm"):
        try:
            text = open(os.path.join(root, ".info", "version")).read().strip()
        except (TypeError, OSError):
            continue
        n = ""
        for c in text:
            if not (c.isdigit() or c == "."):
                break
            n += c
        if n.strip("."):
            return n.strip(".")
    return None

def gpus():
    if "OAKA_GPUS" in os.environ:
        return [a.strip() for a in os.environ["OAKA_GPUS"].split(",") if a.strip()]
    nodes = []
    for props in glob.glob("/sys/class/kfd/kfd/topology/nodes/*/properties"):
        for line in open(props):
            if line.startswith("gfx_target_version "):
                v = int(line.split()[1])
                if v:
                    nodes.append((int(props.split("/")[-2]), f"gfx{v // 10000}{(v // 100) % 100:x}{v % 100:x}"))
    if nodes:
        return [a for _, a in sorted(nodes)]
    try:  # NVIDIA: nvidia-smi's order (PCI), compute capability 10.3 = sm_103
        out = subprocess.run(["nvidia-smi", "--query-gpu=compute_cap", "--format=csv,noheader"],
                             capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    return ["sm_" + c.strip().replace(".", "") for c in out.split() if c.strip()] or None

def fits(pattern, version):
    have = version.split(".")
    for i, want in enumerate(pattern.split(".")):
        got = have[i] if i < len(have) else "0"
        if want != "*" and not (got.isdigit() and int(got) == int(want)):
            return False
    return True

r, archs = rocm(), gpus()
for d in sys.argv[1].split(","):
    a = archs[int(d)] if archs and int(d) < len(archs) else None
    found = [t for t in TARGETS if a is None or t[0] in ("*", a)]
    if not found:
        sys.exit(f"[server {{ name }}] FATAL: GPU {d} is {a}, but profile {{ profile }} is for {WANT}")
    if not any(t[1] == "*" or (r is not None and fits(t[1], r)) for t in found):
        sys.exit(f"[server {{ name }}] FATAL: this container has ROCm {r or 'unknown'}"
                 f"{' on ' + a if a else ''}, but profile {{ profile }} is for {WANT}")
PY
{% endif %}

# Empty compile caches at every start, as InferenceX's runners give each job its own: every
# server compiles its kernels from nothing, so servers measured one after another start
# alike instead of the later ones reusing the earlier ones' kernels.  step.sh puts them in
# the step's logs/; the plan's or profile's env below may still point any of them elsewhere.
CACHE="${OAKA_SERVER_CACHE:-$(dirname "$(dirname "$(realpath "$0")")")/logs/cache_{{ name }}}"
case "$CACHE" in
    /*/cache_{{ name }}) ;;
    *) say "FATAL: OAKA_SERVER_CACHE=$CACHE must be an absolute path ending in /cache_{{ name }}"; exit 1 ;;
esac
rm -rf "$CACHE"
{% for c in caches %}
export {{ c[0] }}="$CACHE/{{ c[1] }}"
mkdir -p "${{ c[0] }}"
{% endfor %}
{% if pythonpath %}
# The plan's stack trees go first: the image puts its own checkouts on PYTHONPATH too.
export PYTHONPATH={{ pythonpath | q }}${PYTHONPATH:+:$PYTHONPATH}
{% endif %}
{% for kv in env %}
export {{ kv[0] }}={{ kv[1] | q }}
{% endfor %}
{% if profiler_env %}
# A trace client profiles this server: SGLang's profiler V2, which captures by stage (oaka's,
# like the visible devices; not part of the profile).
export {{ profiler_env }}
{% endif %}

ARGS=(
{% for line in fixed %}
    {{ line }}
{% endfor %}
{% for line in args %}
    {{ line }}
{% endfor %}
)

# Provenance: what is about to run, and on which stack.
say "$(date -Is) $(realpath "$0")"
MODEL={{ model | q }}
say "profile {{ profile }}  model $MODEL  tp {{ tp }}  gpus ${{ visible }}  port $PORT"
python3 -m pip show {{ packages }} 2>/dev/null \
    | grep -E '^(Name|Version|Location|Editable project location):' | sed 's/^/[server {{ name }}] pip /' || true
env | grep -E '^(HIP|HSA|ROCM|CUDA|AITER|SGLANG|VLLM|ATOM|TRITON|XDG_CACHE|ENABLE_CK|NCCL|RCCL|TORCH|PYTORCH|FLASHINFER)' | sort | sed 's/^/[server {{ name }}] env /'
say "cmd {{ command }} ${ARGS[*]}"

exec {{ command }} "${ARGS[@]}"
