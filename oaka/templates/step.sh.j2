#!/usr/bin/env bash
# {{ marker }}
# One measurement with whatever stack is installed: start every server, wait until each
# is ready (a PD server's router after its prefill and decode servers), run the clients in plan order (a lockstep's together, where its first is), then
# stop the servers (also on failure or Ctrl-C).  Each part is its own script and can be run by hand instead.
#   bash {{ self_path }} [<label>]     # logs/<label>/ and results/<label>/ (emptied first);
#                                      # no label: logs/ and results/, overwriting same-named points
# Exits 0, 3 when a client's gate failed (score or throughput below its minimum), 1 for
# anything else (a server that did not come up, a client that broke).
set -uo pipefail

HERE="$(cd "$(dirname "$0")" && pwd)"
WORKDIR="$(dirname "$HERE")"
LABEL="${1:-}"
case "$LABEL" in
    /* | *..* | *[!A-Za-z0-9_./-]*) echo "step.sh: label $LABEL must be a relative name like 1_abc123 or bisect/abc123" >&2; exit 1 ;;
esac
LOGS="$WORKDIR/logs${LABEL:+/$LABEL}"
export RESULTS="$WORKDIR/results${LABEL:+/$LABEL}"
# A labeled step is a fresh measurement: no numbers from an earlier run of it may remain.
[ -n "$LABEL" ] && rm -rf "$RESULTS"
mkdir -p "$LOGS"
say() { echo "[step${LABEL:+ $LABEL} $(date +%H:%M:%S)] $*"; }

READY_MARK="The server is fired up and ready"   # SGLang's; the other engines answer GET /health
CRASH_MARKS="Received sigquit from a child process|Scheduler hit an exception|Capture cuda graph failed"
READY_TIMEOUT_S={{ ready_timeout_s }}

PIDS=()
declare -A PID_OF=()
declare -A NAME_OF=()
declare -A STATE_OF=()
SERVER_STATE_DIR=$(mktemp -d "$LOGS/.server_ownership.XXXXXX") || exit 1
stop_servers() {
    if [ -z "${PIDS[*]:-}" ]; then
        rm -rf "$SERVER_STATE_DIR"
        return 0
    fi
    trap '' INT TERM PIPE   # a second Ctrl-C must not cut the cleanup short
    say "stopping servers"
    local pid state rc states=() verified=1
    # Every registered bootstrap is told to stop before anything else: one without .go can
    # then never exec its server.
    for pid in "${PIDS[@]}"; do
        : > "${STATE_OF[$pid]}.stop" || verified=0
    done
    for pid in "${PIDS[@]}"; do
        state=${STATE_OF[$pid]}
        if [ -e "$state.go" ]; then
            states+=("$pid" "$state")
            continue
        fi
        # Never acknowledged: still this shell's own (not disowned) job, so `wait` reaps
        # exactly it; the bootstrap exits on .stop, or by itself within its ack timeout.
        rm -f "$SERVER_STATE_DIR/wait.err"
        wait "$pid" 2>"$SERVER_STATE_DIR/wait.err"
        rc=$?
        if [ -s "$SERVER_STATE_DIR/wait.err" ]; then
            say "server ${NAME_OF[$pid]}: bootstrap pid $pid could not be reaped: $(cat "$SERVER_STATE_DIR/wait.err")"
            verified=0
        else
            say "server ${NAME_OF[$pid]} never started (its bootstrap exited $rc before exec)"
        fi
    done
    # The helper validates PID/start/UID/session/group and signals through pidfds.
    # TERM only leaders; after 60 s KILL surviving owned members, even after leader death,
    # and allow 60 s more for them to go.
    if [ -n "${states[*]:-}" ]; then
        python3 -I -S "$HERE/server_processes.py" stop "${states[@]}" || verified=0
    fi
    if [ $verified -eq 0 ]; then
        say "server cleanup unverified; retaining compile caches and ${SERVER_STATE_DIR#"$WORKDIR"/}"
        return 1
    fi
    PIDS=()
    # The servers' compile caches (up to a GB each) are of no use once they are gone.
    rm -rf "$LOGS"/cache_* "$SERVER_STATE_DIR"
}
CLIENT_PIDS=()
PROBE_PID=
stop_clients() {
    # A readiness probe still waiting on a router (started with SIGINT ignored, as background
    # jobs of a script are).
    [ -n "$PROBE_PID" ] && kill -KILL "$PROBE_PID" 2>/dev/null && wait "$PROBE_PID" 2>/dev/null
    PROBE_PID=
    for pid in "${CLIENT_PIDS[@]}"; do kill -TERM -- "-$pid" 2>/dev/null; done
    CLIENT_PIDS=()
}
finish() {
    local rc=$?
    trap - EXIT
    stop_clients
    stop_servers || { [ $rc -ne 0 ] || rc=1; }
    exit "$rc"
}
trap finish EXIT
trap 'exit 130' INT TERM

# start_server <name>: own process group, so stopping it also stops its workers; its empty
# compile caches in this step's logs/.
start_server() {
    local state="$SERVER_STATE_DIR/$1.json" pid cancelled=0
    : >"$LOGS/server_$1.log"
    # Defer cancellation until the child is registered and its pre-exec identity
    # exists. The bootstrap cannot run server/package code before publishing it.
    trap 'cancelled=1' INT TERM
    OAKA_SERVER_CACHE="$LOGS/cache_$1" python3 -I -S "$HERE/server_processes.py" start "$state" "$HERE/server_$1.sh" "$$" \
        >"$LOGS/server_$1.log" 2>&1 &
    pid=$!
    PIDS+=("$pid")
    PID_OF[$1]=$pid
    NAME_OF[$pid]=$1
    STATE_OF[$pid]=$state
    for _ in $(seq 1 100); do
        [ -s "$state" ] && break
        sleep 0.05
    done
    trap 'exit 130' INT TERM
    [ $cancelled -eq 0 ] || exit 130
    [ -s "$state" ] || {
        say "server $1 identity missing; startup refused (see ${LOGS#"$WORKDIR"/}/server_$1.log)"
        exit 1
    }
    : > "$state.go" || exit 1
    # Registered: from here on the helper owns it by identity, not this shell by job.
    disown "$pid"
    say "server $1 started (pid $pid), log ${LOGS#"$WORKDIR"/}/server_$1.log"
}

# healthy <port>: GET /health answers 200 (how InferenceX waits for vllm and ATOM).
healthy() {
    local status
    status="$( (exec 3<>"/dev/tcp/127.0.0.1/$1" \
        && printf 'GET /health HTTP/1.0\r\nHost: 127.0.0.1\r\n\r\n' >&3 \
        && timeout 5 head -1 <&3) 2>/dev/null)"
    [[ "$status" == HTTP/*" 200"* ]]
}

# generates <port>: a one-token POST /generate answers 200.  A PD router's /health can answer
# before its prefill and decode servers are registered; a generation goes through both.  In
# the background, with a short timeout: bash runs the INT/TERM traps only once a foreground
# command ends, but at once during `wait`.
generates() {
    python3 - "$1" <<'PY' 2>/dev/null &
import json, sys, urllib.request
body = json.dumps({"text": "Hello", "sampling_params": {"max_new_tokens": 1, "temperature": 0}}).encode()
req = urllib.request.Request(f"http://127.0.0.1:{sys.argv[1]}/generate", data=body,
                             headers={"Content-Type": "application/json"})
try:
    sys.exit(0 if urllib.request.urlopen(req, timeout=30).status == 200 else 1)
except Exception:
    sys.exit(1)
PY
    PROBE_PID=$!
    wait $PROBE_PID
    local rc=$?
    PROBE_PID=
    return $rc
}

# died <name>: the server crashed or exited; says so with the end of its log.
died() {
    local log="$LOGS/server_$1.log" rc
    if ! grep -qE "$CRASH_MARKS" "$log"; then
        python3 -I -S "$HERE/server_processes.py" alive "${PID_OF[$1]}" "${STATE_OF[${PID_OF[$1]}]}"
        rc=$?
        [ $rc -eq 0 ] && return 1
        if [ $rc -ne 3 ]; then
            say "server $1: ownership unknown (exit $rc); stopping"
            return 0
        fi
    fi
    say "server $1 died during startup; last lines of ${log#"$WORKDIR"/}:"
    tail -30 "$log"
}

# any_died: some server started so far died (said by `died`).
any_died() {
    local name
    for name in "${!PID_OF[@]}"; do
        died "$name" && return 0
    done
    return 1
}

# wait_ready <name> log | health <port> | generate <port>: ready by its log line, by GET
# /health on the port, or by a generation through it, and every server started so far still
# alive (a router can answer through some of its servers while another one is gone).
wait_ready() {
    local name=$1 how=$2 port=${3:-} deadline=$(( $(date +%s) + READY_TIMEOUT_S )) via
    while true; do
        any_died && return 1
        case $how in
            log) via=""; grep -q "$READY_MARK" "$LOGS/server_$name.log" ;;
            health) via=" (GET /health)"; healthy "$port" ;;
            generate) via=" (POST /generate)"; generates "$port" ;;
        esac && {
            any_died && return 1
            say "server $name ready$via"
            return 0
        }
        if [ "$(date +%s)" -ge $deadline ]; then
            say "server $name not ready after ${READY_TIMEOUT_S}s"
            return 1
        fi
        sleep 1
    done
}

# run_client <script>: a gate failure (exit 3) stays 3, anything else becomes 1.
run_client() {
    say "client $1"
    bash "$HERE/$1"
    local rc=$?
    case $rc in
        0) return 0 ;;
        3) say "client $1: gate failed; stopping" ;;
        130) exit 130 ;;
        *) say "client $1 failed (exit $rc); stopping"; rc=1 ;;
    esac
    exit $rc
}

# lockstep_summary <name> <script>...: results/lockstep_<name>/summary.csv, one row per point:
# the worst server's (lowest output tok/s) of the clients' summary rows, each a point's first
# run.  The servers ran each point at the same time, so the slowest is what each of them can
# be counted on for.  Written when every client has its summary.csv.
lockstep_summary() {
    local name=$1 c sums=()
    shift
    for c in "$@"; do
        c=${c#client_}
        sums+=("$RESULTS/${c%.sh}/summary.csv")
    done
    python3 - "$RESULTS/lockstep_$name" "${sums[@]}" <<'PY'
import csv, os, sys
out, sums = sys.argv[1], sys.argv[2:]
if not all(os.path.exists(p) for p in sums):
    sys.exit(0)
cols, worst = None, {}
for p in sums:
    with open(p, newline="") as f:
        rows = list(csv.reader(f))
    cols = rows[0]
    for row in rows[1:]:
        point = tuple(row[1:4])
        try:
            tok = float(row[4])
        except ValueError:
            tok = float("-inf")
        if point not in worst or tok < worst[point][0]:
            worst[point] = (tok, row)
os.makedirs(out, exist_ok=True)
rows = sorted((row for _, row in worst.values()), key=lambda r: (int(r[1]), int(r[2]), int(r[3])))
with open(os.path.join(out, "summary.csv"), "w", newline="") as f:
    csv.writer(f).writerows([cols] + rows)
print(f"lockstep summary (each point's slowest server): {os.path.join(out, 'summary.csv')}")
PY
}

# run_lockstep <name> <script>...: the clients at the same time, each in its own process
# group, every run of every point started together (the clients wait for each other in
# logs/lockstep_<name>/).  A client that fails marks it aborted, so the others stop before
# their next run.  Then lockstep_summary.  Exit codes as run_client's; Ctrl-C (130) beats a
# failure (1), which beats a gate (3).
run_lockstep() {
    local name=$1 dir="$LOGS/lockstep_$1" rc worst=0 pid
    shift
    rm -rf "$dir"
    mkdir -p "$dir"
    say "lockstep $name: $*"
    local -A file_of=()
    for c in "$@"; do
        OAKA_LOCKSTEP_DIR="$dir" OAKA_LOCKSTEP_N=$# setsid bash "$HERE/$c" &
        CLIENT_PIDS+=($!)
        file_of[$!]=$c
    done
    while [ -n "${file_of[*]}" ]; do
        wait -n -p pid "${!file_of[@]}"
        rc=$?
        [ -z "$pid" ] && continue
        case $rc in
            0) ;;
            3) say "client ${file_of[$pid]}: gate failed"; [ $worst -eq 0 ] && worst=3 ;;
            130) worst=130 ;;
            *) say "client ${file_of[$pid]} failed (exit $rc)"; [ $worst -ne 130 ] && worst=1 ;;
        esac
        [ $rc -ne 0 ] && : >"$dir/abort"
        unset "file_of[$pid]"
    done
    CLIENT_PIDS=()
    [ $worst -ne 130 ] && lockstep_summary "$name" "$@"
    case $worst in
        0) return 0 ;;
        3) say "lockstep $name: gate failed; stopping" ;;
        130) exit 130 ;;
        *) say "lockstep $name failed; stopping" ;;
    esac
    exit $worst
}

{% for stage in stages %}
{% for s in stage %}
start_server {{ s.name }}
{% endfor %}
{% for s in stage %}
wait_ready {{ s.name }} {{ s.ready }} || exit 1
{% endfor %}
{% endfor %}

{% for r in runs %}
{% if r.lockstep %}
run_lockstep {{ r.lockstep }} {{ r.files | join(" ") }}
{% else %}
run_client {{ r.files[0] }}
{% endif %}
{% endfor %}
say "done"
