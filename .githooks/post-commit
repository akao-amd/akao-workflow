#!/bin/sh
# After every commit, refresh the binaries the dev environment runs, so neither can lag
# behind the committed code:
#   - akao: release build in target/release/akao (link it onto PATH once; see README.md)
#   - oaka: static (musl) builds in the library's bin/, ${OAKA_LIB:-<repo>/oaka}/bin/oaka
#     (x86_64) and bin/oaka.aarch64 (git-ignored), which `akao init` ships into each
#     worker's clone of this repo
#
# Enable once per clone:  git config core.hooksPath .githooks
# A failed build never blocks the commit (it already happened); it is reported instead.
set -u
top="$(git rev-parse --show-toplevel)"
manifest="$top/Cargo.toml"

if cargo build --release -q -p akao --manifest-path "$manifest"; then
    echo "post-commit: built $top/target/release/akao ($("$top/target/release/akao" --version))"
else
    echo "post-commit: akao build failed; target/release/akao is stale" >&2
fi

lib="${OAKA_LIB:-$top/oaka}"
# One static oaka per worker CPU: bin/oaka (x86_64) and bin/oaka.aarch64 (the ARM64 GB300
# trays; linked by rust-lld, .cargo/config.toml).  init ships the one the container runs.
for target in x86_64-unknown-linux-musl aarch64-unknown-linux-musl; do
    case $target in
        x86_64-*) dest="$lib/bin/oaka" ;;
        *) dest="$lib/bin/oaka.aarch64" ;;
    esac
    if ! cargo build --release -q -p oaka --target "$target" --manifest-path "$manifest"; then
        echo "post-commit: oaka build for $target failed (rustup target add $target?); $dest not updated" >&2
        continue
    fi
    mkdir -p "$lib/bin" && cp "$top/target/$target/release/oaka" "$dest.tmp" && mv "$dest.tmp" "$dest" \
        && echo "post-commit: installed $dest ($(file -b "$dest" | cut -d, -f2 | sed 's/^ //'))"
done
"$lib/bin/oaka" --version >/dev/null 2>&1 && echo "post-commit: $("$lib/bin/oaka" --version)"
exit 0
